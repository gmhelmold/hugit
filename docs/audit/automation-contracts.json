"selection":"All .py/.sh, workflow .yml/.yaml, interpreter shebangs excluding Rust inner attributes, executable-bit files, and explicit Cargo/Claude automation configs in the pinned source inventory.",
"profiles":{
"cargo_config":{"role":"build_configuration","may_effects":["build_parallelism"],"condition":"jobs=4 configures Cargo; configuration is not a test execution.","destination_wp":"HUG-001"},
"agent_config":{"role":"hook_registration","may_effects":["spawn_registered_hook"],"condition":"PreToolUse registers the local path guard; deny rules are configuration, not goal capture.","destination_wp":"HUG-028"},
"agent_guard":{"role":"local_permission_guard","may_effects":["read_stdin","read_path_metadata","exit_decision"],"condition":"Evaluates hook input and path policy; --selftest exercises decisions. Not the goal producer and not executed in this audit.","destination_wp":"HUG-028"},
"changelog_gate":{"role":"local_structural_gate","may_effects":["git_read","file_read"],"condition":"Reads commit messages, diff and Unreleased. Presence checks are not semantic acceptance of changes.","destination_wp":"HUG-003"},
"ci":{"role":"workflow_build_and_test","may_effects":["checkout","tool_download","build_write","test_execution"],"condition":"PR path filters and same-repository guard apply; push main excludes docs/Markdown-only changes. Job commands, not comments, define gates.","destination_wp":"HUG-003"},
"dco":{"role":"workflow_trailer_check","may_effects":["checkout","git_read"],"condition":"Same-repository pull_request; checks existence of Signed-off-by trailers, not signer authentication.","destination_wp":"HUG-003"},
"evidence_ci":{"role":"workflow_evidence","may_effects":["checkout","tool_download","build_write","product_fixture_execution","artifact_upload"],"condition":"Build and produce run locally in runner; fresh-host verifier validates retained package, not a new execution of each claim. Artifacts do not confer WP approval.","destination_wp":"HUG-051"},
"release_ci":{"role":"workflow_publisher","may_effects":["tool_download","build_write","test_execution","artifact_upload","github_release_write"],"condition":"Only v* tag workflow; native tests run on host, not automatically on the cross-compiled x86_64 macOS target; publish job requires successful build matrix. Not triggered by this audit.","destination_wp":"HUG-053"},
"plan_ci":{"role":"workflow_plan_check","may_effects":["checkout","generated_view_check"],"condition":"Historical workflow calls check_import and test_sync only. Subsequent inventory checks are separately versioned integrator deltas.","destination_wp":"HUG-003"},
"plan_models":{"role":"bounded_reference_models","may_effects":["model_evaluation","report_write"],"condition":"Finite reference models and report outputs; not runtime implementation proof.","destination_wp":"HUG-059"},
"plan_probe":{"role":"isolated_native_reference","may_effects":["temporary_git_write","sqlite_write","subprocess","process_exit","report_write"],"condition":"Creates private Git/SQLite fixtures; optional --worker runs inside supplied fixture. Not a Hugit implementation or power-loss test.","destination_wp":"HUG-044"},
"plan_qualification":{"role":"verification_library","may_effects":["artifact_read","signature_check"],"condition":"Imports cryptography and verifies demo-only A/B/C; caller supplies key pins. No product release authority.","destination_wp":"HUG-055"},
"plan_generate":{"role":"generated_document_tool","may_effects":["plan_read","generated_files_write","canonical_plan_write"],"condition":"Renderer writes generated views; refresh updates canonical backlog digests only with --ack-semantic-review-required. Neither operation approves changes.","destination_wp":"HUG-002"},
"plan_validate":{"role":"plan_validation","may_effects":["file_read","optional_report_write"],"condition":"Checks data/views/manifest or preflight; preflight is not release authorization. Does not run product tests.","destination_wp":"HUG-002"},
"plan_tests":{"role":"plan_test_harness","may_effects":["temporary_files","reference_execution","report_write"],"condition":"Tests reference algorithms/data; test_qualification runs demo subprocess and signatures. Positive fixtures are not product qualification.","destination_wp":"HUG-055"},
"import_check":{"role":"import_validation","may_effects":["plan_read","trusted_validator_import"],"condition":"Imports the versioned local validators and compares generated views with approved digests; no runtime qualification.","destination_wp":"HUG-002"},
"import_restore":{"role":"pure_reconstruction_library","may_effects":["in_memory_reconstruction"],"condition":"No main or file/network writes in restore(seed,orders); byte reconstruction needs independent digest validation.","destination_wp":"HUG-002"},
"import_sync":{"role":"github_issue_projection","may_effects":["preview_files_write","optional_github_api_write"],"condition":"Default creates preview files. Only --apply instantiates authenticated API client and reconciles labels/issues/subissues/dependencies. Not run by this inventory.","destination_wp":"HUG-002"},
"import_tests":{"role":"importer_unit_tests","may_effects":["trusted_module_import","in_memory_assertions"],"condition":"Tests body projection/identity and dependency reduction without API calls.","destination_wp":"HUG-002"},
"evidence_wrapper":{"role":"evidence_producer_wrapper","may_effects":["spawn_python","delegated_producer_effects"],"condition":"Delegates to evidence_report.py with a configured binary/output; benchmark name is not proof of performance measurement.","destination_wp":"HUG-051"},
"evidence_producer":{"role":"product_fixture_driver","may_effects":["configured_executable","temporary_git_write","output_replace","archive_write"],"condition":"Build mode recursively replaces explicit output and optional work-dir; isolates Git configuration in fixture. --verify performs producer self-check only. Never execute with an important output path.","destination_wp":"HUG-051"},
"evidence_verifier":{"role":"retained_package_verifier","may_effects":["archive_read","temporary_extract","git_subprocess"],"condition":"Checks archive inventory, chain and claim-specific retained observables; does not execute retained Hugit binary. Temporary extraction and Git reads are real effects.","destination_wp":"HUG-051"},
"evidence_tests":{"role":"evidence_harness_tests","may_effects":["temporary_files","subprocess","fixture_corruption"],"condition":"Exercises producer/verifier on fixtures, including deliberate mutations; not arbitrary end-user workload qualification.","destination_wp":"HUG-051"},
"local_journey":{"role":"legacy_local_smoke","may_effects":["fixture_git_write","configured_executable","worktree_cleanup"],"condition":"Requires HUGIT_BIN and optionally a positional workdir; writes fixture/home under that directory, does not build the binary. Legacy simulator/lifecycle checks are not v3 acceptance. Use a disposable workdir.","destination_wp":"HUG-051"},
"acceptance_helper":{"role":"shell_test_library","may_effects":["git_read","caller_command_execution"],"condition":"Sourcing changes cwd and shell error policy; check executes its caller-provided argv. No source-only/pure guarantee.","destination_wp":"HUG-003"},
"legacy_wrapper":{"role":"historical_acceptance_wrapper","may_effects":["shell_commands","possible_cargo_download","build_write","crate_test_execution"],"condition":"Explicit manual invocation; many checks only grep names/structure. Cargo tests run supplied crate code and may access external resources; no network-free guarantee. Not a v3 gate.","destination_wp":"HUG-003"},
"legacy_external":{"role":"discontinued_integration_wrapper","may_effects":["shell_commands","possible_cargo_download","build_write","possible_remote_test_execution"],"condition":"Declares legacy runner/CoreLink/GitHub test configuration; do not execute as a standalone requirement. Configuration is evidence of dependency, not evidence a network request succeeded.","destination_wp":"HUG-004"},
"legacy_document":{"role":"historical_document_check","may_effects":["git_read","shell_commands","document_read"],"condition":"Runner inventory markdown grep only; does not acquire compute or demonstrate runner operation.","destination_wp":"HUG-004"}
