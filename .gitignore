/target
/.techlead/
/.claude/worktrees/
/.claude/scheduled_tasks.lock

# Local Action Cache produced by `hugit check --store` during snapshot builds (not a source artifact)
engine-snapshots/*.ac

# Secrets and credentials — never commit
.env
.env.*
*.pem
*.key
*.crt
wrangler.toml
ingest.env
.dev.vars

# Editor / OS artifacts
*.swp
.DS_Store
.idea/
.vscode/

# Ephemeral cross-TL courier correspondence (kept on disk, not tracked)
docs/handoff/

# Test-journey litter: a journey test that runs git init / hugit init in the
# WRONG cwd (a cargo test's crate dir) can leave a stray .git/.hugit inside a
# crate. NEVER track these — they break repo_root() and the bundle gate.
crates/*/.git/
crates/*/.hugit/
crates/*/.gitignore

# QUARANTINE — the web-window crates (hugit-serve + http-contracts + itself's
# qa harness). FROZEN by owner decision (2026-09-05): the published plugin is
# the CLI only, git-native, and must not carry the paid-service window (CoreLink
# CAS/Clerk). The code is preserved LOCALLY under quarantine/ for reference; it
# is NOT part of the workspace, the build, or the remote plugin. Do not delete it
# and do not re-enable it without the owner's explicit call. See
# quarantine/README.md for the frozen state and how (if ever) to revive it.
/quarantine/
